#!/bin/sh /etc/rc.common
# procd init script for knockd. Install as /etc/init.d/knockd (chmod +x),
# then: /etc/init.d/knockd enable && /etc/init.d/knockd start

USE_PROCD=1
START=99
STOP=10

PROG=/usr/sbin/knockd
CONF=/etc/knockd/knockd.conf

start_service() {
	# The knock is derived from the wall clock; a router that just booted
	# may still have a bogus date until sysntpd syncs. Refuse to start with
	# an obviously unset clock (before 2024) rather than reject every knock.
	# procd will not retry a failed start_service, so also start this
	# service late (START=99) and re-run it manually if NTP was slow.
	if [ "$(date +%Y)" -lt 2024 ]; then
		logger -t knockd "clock not set yet (year $(date +%Y)); not starting"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Removes the drops for 22/80/443, so a stopped knockd never leaves
	# the router locked to LAN clients. (A hard crash can't run this; see
	# server/openwrt/README.md for the dead-man switch used on first
	# install and the failsafe-mode fallback.)
	nft delete table inet knockd 2>/dev/null
}
