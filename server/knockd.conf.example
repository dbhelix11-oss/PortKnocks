[knock]
keyfile = /etc/knockd/secret.key
time_step = 30
n_ports = 6
port_low = 20000
port_high = 60000
inactivity_timeout = 5
replay_ttl = 90

[server]
interface = eth0
target_port = 22
open_duration = 30
# Must run before whatever chain enforces the default-deny policy on
# target_port -- lower priority values run earlier in nftables' input hook.
base_chain_priority = -10

# debug | info | warn | error. debug logs every observed knock candidate
# and every sequence reset -- noisy, but useful while setting things up.
# Logs go to stderr; run knockd under systemd and use `journalctl -u knockd`.
log_level = info

# Channel 0 always means "open target_port above" -- not configurable here.
# Channels 1-10 each run one pre-configured command, with no arguments,
# when that channel's knock sequence is verified. A channel with no
# [channel.N] section (or no `command` key) logs a warning and does
# nothing. See docs/channel-signaling-design.html for why channels are a
# separate hashed input rather than a time-shifted variant of channel 0.
#
# [channel.1]
# command = /etc/knockd/scripts/channel1.sh
#
# [channel.2]
# command = /etc/knockd/scripts/channel2.sh
