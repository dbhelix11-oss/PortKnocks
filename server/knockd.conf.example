[knock]
keyfile = /etc/knockd/secret.key
time_step = 30
n_ports = 6
port_low = 20000
port_high = 60000
inactivity_timeout = 5
replay_ttl = 90

[server]
interface = eth0
# One port, or several separated by commas and/or whitespace (e.g.
# `22, 80 443`) -- a channel-0 knock opens all of them together for the
# knocking source IP, via the same timed allow-set.
target_port = 22
# An already-established connection on target_port survives past
# open_duration regardless (see the `ct state established,related accept`
# rule knockd always installs first) -- only *new* connection attempts
# are gated by this timer. So open_duration only needs to comfortably
# cover the time it takes to complete a TCP handshake after a valid
# knock, not the whole session lifetime; a short value (e.g. 5-10s)
# narrows the window during which a second, unrelated knock could also
# get in, without cutting off connections already in progress.
open_duration = 30
# Priority within nftables' input hook; knockd's own chain owns the
# complete policy described below regardless of this value (see
# firewall.hpp) -- this mostly matters if you have other knockd-managed
# chains and want to control their relative order.
base_chain_priority = -10

# debug | info | warn | error. debug logs every observed knock candidate
# and every sequence reset -- noisy, but useful while setting things up.
# Logs go to stderr; run knockd under systemd and use `journalctl -u knockd`.
log_level = info

# false (default): knockd only ever touches target_port -- an accept
# rule for knocked-in source IPs, a fallback drop for everyone else on
# that one port, nothing else on the host is affected.
#
# true: knockd's chain becomes the default-deny authority for the WHOLE
# host, not just target_port -- its own policy is `drop`, so anything
# not explicitly allowed below (or already an established connection)
# is blocked. Use always_allow_ports for anything that must stay
# reachable regardless of any knock (e.g. a decoy/monitored port). This
# only works because it's all in knockd's own chain -- adding a
# SEPARATE "block everything except port 22" chain elsewhere on the
# host will NOT reliably override knockd's own accept decisions; see
# firewall.hpp's comment for why (independent nftables base chains at
# the same hook don't override each other's terminal verdicts).
# default_deny = true
# always_allow_ports = 22

# Channel 0 always means "open target_port above" -- not configurable here.
# Channels 1-10 each run exactly ONE of two actions, set in their own
# [channel.N] section, when that channel's knock sequence is verified:
#
#   command = <path>       run this command, no arguments (fork+execve,
#                           never a shell)
#   open_port = <N[, N...]>  open this port (or these ports, comma-
#                           and/or whitespace-separated, same grammar as
#                           target_port above) for the knocking source IP,
#                           the same way channel 0 opens target_port --
#                           its own timed allow-set, independent of
#                           channel 0's and every other channel's.
#
# Setting both in the same [channel.N] section is a config error (knockd
# refuses to start). A channel with no [channel.N] section, or one with
# neither key, logs a warning and does nothing when it fires. See
# docs/channel-signaling-design.html for why channels are a separate
# hashed input rather than a time-shifted variant of channel 0.
#
# [channel.1]
# command = /etc/knockd/scripts/channel1.sh
#
# [channel.2]
# open_port = 8080
#
# [channel.3]
# open_port = 8080, 8443
